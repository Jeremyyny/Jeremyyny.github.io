@inproceedings{yang2026margent,
  title={MARGENT: Measuring the Marginal Value of Delegation in Agentic Systems},
  author={Yang, Yuning and Li, Jingxuan and Zhao, Yizhou and Zhang, Linfan and Jin, Longhao and Li, Manling and Liu, Han and Wu, Ying Nian},
  booktitle={NeurIPS 2026 Workshop on Resource-Aware Agentic AI},
  year={2026},
  abbr={NeurIPS WS},
  abstract={Agentic systems increasingly rely on specialized agents to improve reasoning, but each additional interaction consumes computation and may leave an answer unchanged or even corrupt a correct one. Existing systems often follow fixed interaction patterns or select calls using query features and model confidence. These signals do not directly establish whether another agent can improve the candidate answer already under consideration. This raises a fundamental question: When is additional intelligence worth it? We introduce MARGENT, a trainable framework for a manager that must either commit to its current answer or delegate to a sub-agent. By comparing commitment and delegation from the same manager-generated state, MARGENT measures the marginal value of a call and distills shortest successful branches into supervision for useful delegation and timely stopping. Re-collecting these branches after manager updates extends the same principle to recursive self-improvement. Across four reasoning benchmarks, the best single-call oracle captures 91.7\% of the measured multi-call oracle gain on average. Trained managers improve their own pre-delegation accuracy by 17.1 percentage points with 0.53 sub-agent calls per question. On development data, roughly one selected call matches three forced calls on MMLU-Pro and outperforms them on AQuA-RAT. Iterative experiments further examine how refreshing supervision adapts delegation to a changing manager. These results support allocating additional computation according to its marginal value at the current reasoning state, with both useful calls and timely commitment learned from measured outcomes.},
  html={https://openreview.net/forum?id=Mpl470ufM0},
  selected={true}
}

@inproceedings{li2024quantifying,
  title={Quantifying Preferences of Vision-Language Models via Value Decomposition in Social Media Contexts},
  author={Li*, Jingxuan and Yang*, Yuning and Yang, Shengqi and Zhang, Linfan and Wu, Ying Nian},
  booktitle={The 63rd Annual Meeting of the Association for Computational Linguistics, 2025.},
  year={2025},
  abbr={ACL Main},
  abstract={The recent progress in Vision-Language Models (VLMs) has broadened the scope of multimodal applications. However, evaluations often remain limited to functional tasks, neglecting abstract dimensions such as personality traits and human values. To address this gap, we introduce Value-Spectrum, a novel Visual Question Answering (VQA) benchmark aimed at assessing VLMs based on Schwartz's value dimensions that capture core human values guiding people’s preferences and actions. We design a VLM agent pipeline to simulate video browsing and construct a vector database comprising over 50,000 short videos from TikTok, YouTube Shorts, and Instagram Reels. These videos span multiple months and cover diverse topics, including family, health, hobbies, society, technology, etc. Benchmarking on Value-Spectrum highlights notable variations in how VLMs handle value-oriented content. Beyond identifying VLMs' intrinsic preferences, we also explore the ability of VLM agents to adopt specific personas when explicitly prompted, revealing insights into the adaptability of the model in role-playing scenarios. These findings highlight the potential of Value-Spectrum as a comprehensive evaluation set for tracking VLM preferences in value-based tasks and abilities to simulate diverse personas. The complete code and data are available at https://github.com/Jeremyyny/Value-Spectrum.},
  pdf={https://arxiv.org/abs/2411.11479},
  website={https://jeremyyny.github.io/ValueSpectrum.github.io/},
  code={https://github.com/Jeremyyny/Value-Spectrum},
  poster={https://github.com/Jeremyyny/Jeremyyny.github.io/blob/master/assets/pdf/Value_Poster_25.png},
  selected={true}
}

